---
// Video with custom controls: a big play button over the poster, and a bottom bar with
// play/pause, seek, time, mute and fullscreen. Native controls stay on until the script
// runs, so the video still plays if JavaScript fails.
interface Props {
    src: string;
    poster: string;
    label: string;
    class?: string;
}

const { src, poster, label, class: className } = Astro.props;

const icon = {
    xmlns: 'http://www.w3.org/2000/svg',
    viewBox: '0 0 24 24',
    fill: 'none',
    stroke: 'currentColor',
    'stroke-width': '2',
    'stroke-linecap': 'round',
    'stroke-linejoin': 'round',
    'aria-hidden': 'true',
} as const;
---

<div class:list={['video-player group relative overflow-hidden bg-black', className]} data-video-player data-paused>
    <!-- Loads only when played, so a large file isn't fetched with the page. -->
    <video
        class="block size-full object-cover"
        src={src}
        poster={poster}
        controls
        playsinline
        preload="none"
        aria-label={label}
    ></video>

    <!-- Big centered play button, shown while paused. -->
    <button
        type="button"
        data-action="big-play"
        aria-label="Play"
        class="absolute top-1/2 left-1/2 hidden size-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-black/45 text-white ring-1 ring-white/30 backdrop-blur-md transition hover:scale-105 hover:bg-black/60 focus-visible:outline-2 focus-visible:outline-white"
    >
        <svg {...icon} class="ml-1 size-7" fill="currentColor"><path d="M7 4.5v15l12-7.5z" /></svg>
    </button>

    <!-- Bottom control bar. -->
    <div
        data-controls
        class="absolute inset-x-0 bottom-0 hidden items-center gap-2 bg-linear-to-t from-black/80 via-black/50 to-transparent px-3 pt-10 pb-3 text-white transition-opacity duration-300"
    >
        <button type="button" data-action="toggle" aria-label="Play" class="control-button">
            <svg {...icon} class="icon-play size-5" fill="currentColor"><path d="M7 4.5v15l12-7.5z" /></svg>
            <svg {...icon} class="icon-pause size-5" fill="currentColor" stroke="none">
                <rect x="6" y="4.5" width="4" height="15" rx="1" /><rect x="14" y="4.5" width="4" height="15" rx="1" />
            </svg>
        </button>

        <input type="range" data-seek min="0" max="1000" step="1" value="0" aria-label="Seek" class="seek min-w-0 flex-1" />

        <span data-time class="shrink-0 text-xs tabular-nums">0:00</span>

        <button type="button" data-action="mute" aria-label="Mute" class="control-button">
            <svg {...icon} class="icon-volume size-5">
                <path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor" /><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" />
            </svg>
            <svg {...icon} class="icon-muted size-5">
                <path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor" /><path d="m16 9 6 6M22 9l-6 6" />
            </svg>
        </button>

        <button type="button" data-action="fullscreen" aria-label="Fullscreen" class="control-button">
            <svg {...icon} class="size-5">
                <path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3" />
            </svg>
        </button>
    </div>
</div>

<style>
    @reference "../styles/global.css";

    /* Custom controls take over once the script marks the player as ready. */
    .video-player[data-ready] [data-action='big-play'] {
        display: none;
    }
    .video-player[data-ready][data-paused] [data-action='big-play'] {
        display: flex;
    }
    .video-player[data-ready] [data-controls] {
        display: flex;
    }

    /* While playing, the bar fades out until the pointer moves or a control has focus. */
    .video-player[data-ready]:not([data-paused]):not([data-active]):not(:focus-within) [data-controls] {
        opacity: 0;
    }
    .video-player[data-ready]:not([data-paused]):not([data-active]):not(:focus-within) {
        cursor: none;
    }
    /* Before the first play, only the big button shows over the poster. */
    .video-player[data-ready][data-unstarted] [data-controls] {
        opacity: 0;
        pointer-events: none;
    }

    .control-button {
        @apply flex size-9 shrink-0 items-center justify-center rounded-full transition hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-white;
    }

    .video-player .icon-pause,
    .video-player .icon-muted {
        display: none;
    }
    .video-player:not([data-paused]) .icon-play,
    .video-player[data-muted] .icon-volume {
        display: none;
    }
    .video-player:not([data-paused]) .icon-pause,
    .video-player[data-muted] .icon-muted {
        display: block;
    }

    /* Seek bar: thin track filled up to --progress, round white thumb. */
    .seek {
        --progress: 0%;
        height: 1rem;
        appearance: none;
        background: transparent;
        cursor: pointer;
    }
    .seek::-webkit-slider-runnable-track {
        height: 4px;
        border-radius: 9999px;
        background: linear-gradient(to right, #fff var(--progress), rgb(255 255 255 / 0.3) var(--progress));
    }
    .seek::-moz-range-track {
        height: 4px;
        border-radius: 9999px;
        background: linear-gradient(to right, #fff var(--progress), rgb(255 255 255 / 0.3) var(--progress));
    }
    .seek::-webkit-slider-thumb {
        appearance: none;
        width: 12px;
        height: 12px;
        margin-top: -4px;
        border: 0;
        border-radius: 9999px;
        background: #fff;
        transition: transform 150ms;
    }
    .seek::-moz-range-thumb {
        width: 12px;
        height: 12px;
        border: 0;
        border-radius: 9999px;
        background: #fff;
        transition: transform 150ms;
    }
    .seek:hover::-webkit-slider-thumb,
    .seek:focus-visible::-webkit-slider-thumb {
        transform: scale(1.3);
    }
    .seek:hover::-moz-range-thumb,
    .seek:focus-visible::-moz-range-thumb {
        transform: scale(1.3);
    }
    .seek:focus-visible {
        outline: none;
    }
    .seek:focus-visible::-webkit-slider-thumb {
        box-shadow: 0 0 0 3px rgb(255 255 255 / 0.4);
    }
    .seek:focus-visible::-moz-range-thumb {
        box-shadow: 0 0 0 3px rgb(255 255 255 / 0.4);
    }
</style>

<script>
    const format = (seconds: number) => {
        if (!Number.isFinite(seconds)) return '0:00';
        const s = Math.floor(seconds);
        return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    };

    for (const player of document.querySelectorAll<HTMLElement>('[data-video-player]')) {
        const video = player.querySelector('video')!;
        const seek = player.querySelector<HTMLInputElement>('[data-seek]')!;
        const time = player.querySelector<HTMLElement>('[data-time]')!;
        const toggle = player.querySelector<HTMLButtonElement>('[data-action="toggle"]')!;
        const mute = player.querySelector<HTMLButtonElement>('[data-action="mute"]')!;
        const fullscreen = player.querySelector<HTMLButtonElement>('[data-action="fullscreen"]')!;

        video.controls = false;
        player.dataset.ready = '';
        player.dataset.unstarted = '';

        const playPause = () => (video.paused || video.ended ? video.play() : video.pause());
        const setFlag = (name: string, on: boolean) => {
            if (on) player.dataset[name] = '';
            else delete player.dataset[name];
        };

        // Keep the bar visible for a moment after pointer movement while playing.
        let hideTimer: number | undefined;
        const wake = () => {
            setFlag('active', true);
            clearTimeout(hideTimer);
            hideTimer = window.setTimeout(() => setFlag('active', false), 2500);
        };

        const updateTime = () => {
            const fraction = video.duration ? video.currentTime / video.duration : 0;
            if (!seeking) seek.value = String(Math.round(fraction * 1000));
            seek.style.setProperty('--progress', `${fraction * 100}%`);
            time.textContent = video.duration
                ? `${format(video.currentTime)} / ${format(video.duration)}`
                : format(video.currentTime);
        };

        const updatePlaying = () => {
            setFlag('paused', video.paused);
            toggle.setAttribute('aria-label', video.paused ? 'Play' : 'Pause');
            if (!video.paused) setFlag('unstarted', false);
        };

        const updateMuted = () => {
            setFlag('muted', video.muted);
            mute.setAttribute('aria-label', video.muted ? 'Unmute' : 'Mute');
        };

        let seeking = false;
        seek.addEventListener('input', () => {
            seeking = true;
            if (!video.duration) return;
            video.currentTime = (Number(seek.value) / 1000) * video.duration;
            seek.style.setProperty('--progress', `${Number(seek.value) / 10}%`);
        });
        seek.addEventListener('change', () => (seeking = false));

        video.addEventListener('play', updatePlaying);
        video.addEventListener('pause', updatePlaying);
        video.addEventListener('ended', updatePlaying);
        video.addEventListener('timeupdate', updateTime);
        video.addEventListener('loadedmetadata', updateTime);
        video.addEventListener('durationchange', updateTime);
        video.addEventListener('volumechange', updateMuted);

        video.addEventListener('click', () => {
            playPause();
            wake();
        });
        player.querySelector('[data-action="big-play"]')!.addEventListener('click', () => video.play());
        toggle.addEventListener('click', playPause);
        mute.addEventListener('click', () => (video.muted = !video.muted));

        fullscreen.addEventListener('click', () => {
            if (document.fullscreenElement) {
                document.exitFullscreen();
            } else if (player.requestFullscreen) {
                player.requestFullscreen();
            } else {
                // iPhone Safari only supports fullscreen on the video element itself.
                (video as HTMLVideoElement & { webkitEnterFullscreen?: () => void }).webkitEnterFullscreen?.();
            }
        });
        // In fullscreen show the whole frame rather than a crop.
        document.addEventListener('fullscreenchange', () => {
            video.classList.toggle('object-contain', document.fullscreenElement === player);
            video.classList.toggle('object-cover', document.fullscreenElement !== player);
        });

        player.addEventListener('pointermove', wake);

        updatePlaying();
        updateMuted();
        updateTime();
    }
</script>
