---
// "River" timeline: a gently meandering line down the horizontal center of the slot, drawn
// behind the posts, with a dot at each `[data-river-marker]` (the date row above each post): at
// its `[data-river-dot]` child if it has one, otherwise at its center. A marker's
// `data-river-color` overrides its dot color.
// Every dot pulses together with its bloom; the first (newest post) is white, the others grey. The path is computed in
// the browser from the real marker positions and redrawn whenever the layout changes size. As
// the page scrolls, the line grows from the first dot (at the top of the page) to the last one
// (once the last dot is 70% of the way down the viewport, or at the bottom of the page if it
// can't scroll that far), and each dot and date fades in as the line reaches it (all shown at
// once for reduced motion).
---

<!-- `isolate` keeps the line's negative z-index inside this block: behind the posts, above the page. -->
<div data-river class="relative isolate">
    <svg data-river-svg class="pointer-events-none absolute inset-0 -z-10 size-full overflow-visible" aria-hidden="true">
        <!-- Bloom for the dots, in each dot's own color: a tight bright halo plus a wide soft one,
             both under the dot. -->
        <defs>
            <filter id="river-dot-bloom" x="-600%" y="-600%" width="1300%" height="1300%" color-interpolation-filters="sRGB">
                <feGaussianBlur in="SourceGraphic" stdDeviation="2.5" result="tight-blur" />
                <feComponentTransfer in="tight-blur" result="tight">
                    <feFuncA type="linear" slope="2.5" />
                </feComponentTransfer>
                <feGaussianBlur in="SourceGraphic" stdDeviation="8" result="wide-blur" />
                <feComponentTransfer in="wide-blur" result="wide">
                    <feFuncA type="linear" slope="3" />
                </feComponentTransfer>
                <feMerge>
                    <feMergeNode in="wide" />
                    <feMergeNode in="tight" />
                    <feMergeNode in="SourceGraphic" />
                </feMerge>
            </filter>
        </defs>
        <path data-river-path fill="none" stroke="var(--muted-foreground)" stroke-width="1.5" stroke-linecap="round"></path>
        <g data-river-dots></g>
    </svg>
    <slot />
</div>

<style>
    :global([data-river] [data-river-dots] circle),
    :global([data-river] .river-label) {
        transition: opacity 400ms ease-out;
    }
    :global([data-river] .river-hidden) {
        opacity: 0;
    }
    /* Soft pulse on each dot (the bloom filter scales with it), off for reduced motion. */
    :global([data-river] .river-dot-pulse) {
        transform-box: fill-box;
        transform-origin: center;
        animation: river-pulse 2.4s ease-in-out infinite;
    }
    /* Size only: animating opacity here would override the fade-in of dots not yet reached. */
    @keyframes river-pulse {
        0%,
        100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.4);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        :global([data-river] .river-dot-pulse) {
            animation: none;
        }
    }
</style>

<script>
    const SVG = 'http://www.w3.org/2000/svg';
    // Vertical spacing of the in-between points the curve wanders through.
    const STEP = 38;
    // How far the line wanders left and right of the center, in px.
    const AMPLITUDE = 8;
    // The line is complete once the last dot is this far down the viewport.
    const REVEAL_AT = 0.7;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Point = [number, number];

    // Smooth curve through all points (Catmull-Rom spline as cubic Béziers).
    const smoothPath = (points: Point[]) => {
        let d = `M ${points[0][0]} ${points[0][1]}`;
        for (let i = 0; i < points.length - 1; i++) {
            const p0 = points[i - 1] ?? points[i];
            const p1 = points[i];
            const p2 = points[i + 1];
            const p3 = points[i + 2] ?? p2;
            const c1: Point = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
            const c2: Point = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
            d += ` C ${c1[0]} ${c1[1]}, ${c2[0]} ${c2[1]}, ${p2[0]} ${p2[1]}`;
        }
        return d;
    };

    for (const river of document.querySelectorAll<HTMLElement>('[data-river]')) {
        const svg = river.querySelector<SVGSVGElement>('[data-river-svg]')!;
        const path = river.querySelector<SVGPathElement>('[data-river-path]')!;
        const dots = river.querySelector<SVGGElement>('[data-river-dots]')!;

        let length = 0;
        let anchors: number[] = [];
        let labels: HTMLElement[][] = [];

        // Length along the path at which it reaches height y. The path only ever moves down,
        // so a binary search over its length works.
        const lengthAtY = (y: number) => {
            let lo = 0;
            let hi = length;
            for (let i = 0; i < 20; i++) {
                const mid = (lo + hi) / 2;
                if (path.getPointAtLength(mid).y < y) lo = mid;
                else hi = mid;
            }
            return hi;
        };

        // Draw the line down to the reveal point and show the dots and dates it has reached.
        const reveal = () => {
            if (!anchors.length) return;
            const first = anchors[0];
            const last = anchors[anchors.length - 1];
            // Scroll position at which the line should be complete, capped at the page bottom.
            const riverTop = river.getBoundingClientRect().top + scrollY;
            const maxScroll = document.documentElement.scrollHeight - innerHeight;
            const end = Math.min(maxScroll, riverTop + last - innerHeight * REVEAL_AT);
            // Tip of the line: the first dot at the top of the page, the last at `end`.
            const y = reduceMotion || end <= 0 ? Infinity : first + (last - first) * Math.min(1, Math.max(0, scrollY) / end);
            const drawn = y >= last ? length : y <= first ? 0 : lengthAtY(y);
            path.style.strokeDashoffset = String(length - drawn);
            dots.querySelectorAll('circle').forEach((dot, i) => dot.classList.toggle('river-hidden', anchors[i] > y));
            labels.forEach((group, i) => group.forEach((label) => label.classList.toggle('river-hidden', anchors[i] > y)));
        };

        let frame = 0;
        const onScroll = () => {
            if (frame) return;
            frame = requestAnimationFrame(() => {
                frame = 0;
                reveal();
            });
        };

        const draw = () => {
            const markers = [...river.querySelectorAll<HTMLElement>('[data-river-marker]')];
            if (!markers.length) return;

            // The line meanders around the center: two overlapping sine waves.
            const center = svg.getBoundingClientRect().width / 2;
            const xAt = (y: number) => center + AMPLITUDE * (0.65 * Math.sin(y / 61) + 0.35 * Math.sin(y / 23 + 1.3));

            const top = river.getBoundingClientRect().top;
            anchors = markers.map((marker) => {
                const box = (marker.querySelector('[data-river-dot]') ?? marker).getBoundingClientRect();
                return box.top - top + box.height / 2;
            });
            const colors = markers.map((marker) => marker.dataset.riverColor);
            labels = markers.map((marker) => [...marker.querySelectorAll<HTMLElement>('.river-label')]);
            const first = anchors[0];
            const last = anchors[anchors.length - 1];

            // In-between points every STEP px, skipping any too close to a dot to avoid kinks.
            const ys = [...anchors];
            for (let y = first + STEP; y < last; y += STEP) {
                if (anchors.every((a) => Math.abs(a - y) > STEP / 3)) ys.push(y);
            }
            ys.sort((a, b) => a - b);
            // Dots sit exactly on the center line (lined up with the centered dates); the curve
            // wanders only in between.
            const xOf = (y: number) => (anchors.includes(y) ? center : xAt(y));
            path.setAttribute('d', ys.length > 1 ? smoothPath(ys.map((y) => [xOf(y), y])) : '');

            dots.replaceChildren(
                ...anchors.map((y, i) => {
                    const dot = document.createElementNS(SVG, 'circle');
                    dot.setAttribute('cx', String(center));
                    dot.setAttribute('cy', String(y));
                    dot.setAttribute('r', '4');
                    dot.setAttribute('fill', colors[i] || (i === 0 ? 'var(--foreground)' : 'var(--muted-foreground)'));
                    dot.setAttribute('filter', 'url(#river-dot-bloom)');
                    dot.classList.add('river-dot-pulse');
                    // Offset each dot's pulse a little so they don't all beat in unison.
                    dot.style.animationDelay = `${-i * 0.6}s`;
                    return dot;
                }),
            );

            length = path.getTotalLength();
            path.style.strokeDasharray = String(length);
            reveal();
        };

        draw();
        new ResizeObserver(draw).observe(river);
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll);
    }
</script>
