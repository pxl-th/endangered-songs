---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
// Transparent copy of the logo (ink as alpha, frame removed), used as a CSS mask.
import logoMask from '../assets/endangered-songs-logo-mask.png';
import Post from '../components/Post.astro';
// Intro post: vertical 720×1280 video with its title frame as the poster.
import denmark2Video from '../assets/denmark-2.mp4';
import denmark2Poster from '../assets/denmark-2-poster.jpg';
import { buttonVariants } from '@/components/ui/button';
import katePhoto from '../assets/kate.jpg';
import yanaPhoto from '../assets/yana-kurlyak.png';
import darkaPhoto from '../assets/darka.jpg';
import melaniiaPhoto from '../assets/melaniia-oleshchuk.png';
import martaPhoto from '../assets/marta.jpg';

// People shown below the header: each has a circular photo, a name and an Instagram link.
// A photo's optional `position` sets where the square crop sits (CSS object-position; default centered).
type Person = {
    name: string;
    instagram: string;
    photo: { src: ImageMetadata; alt: string; position?: string };
};
const people: Person[] = [
    {
        name: 'Kateryna Smirnova',
        instagram: 'https://www.instagram.com/katerynasmoss/',
        // Landscape photo: shift the square crop left so she sits in the circle.
        photo: { src: katePhoto, alt: 'Kateryna Smirnova in an embroidered blouse, hands raised to her cheek, among trees', position: '35% 50%' },
    },
    {
        name: 'Yana Kurlyak',
        instagram: 'https://www.instagram.com/yana_kurlyak/',
        photo: { src: yanaPhoto, alt: 'Portrait of Yana Kurlyak' },
    },
    {
        name: 'Darka Symchych',
        instagram: 'https://www.instagram.com/darusyaa_/',
        photo: { src: darkaPhoto, alt: 'Black-and-white portrait of Darka Symchych looking up, in a white blouse' },
    },
    {
        name: 'Melaniia Oleshchuk',
        instagram: 'https://www.instagram.com/melaniaoaoa/',
        // Portrait photo: aim the square crop higher so her face sits in the circle.
        photo: { src: melaniiaPhoto, alt: 'Soft-focus portrait of Melaniia Oleshchuk', position: '50% 25%' },
    },
    {
        name: 'Marta Habalevych',
        instagram: 'https://www.instagram.com/marta.hab/',
        photo: { src: martaPhoto, alt: 'Portrait of Marta Habalevych in a black lace-collared blouse' },
    },
];
---

<Layout title="Endangered Songs">
    <main class="w-full px-4 py-8 md:px-8 md:py-12">
        <Header />

        <!-- Bloom: keep only the brightest parts of the picture, blur them, and screen them back
             over the original so highlights glow into their surroundings (used by .bloom). -->
        <svg class="absolute size-0" aria-hidden="true" focusable="false">
            <filter id="bloom" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
                <!-- Highlights only: luminance below ~55% maps to black. -->
                <feComponentTransfer in="SourceGraphic" result="highlights">
                    <feFuncR type="linear" slope="2.2" intercept="-1.2" />
                    <feFuncG type="linear" slope="2.2" intercept="-1.2" />
                    <feFuncB type="linear" slope="2.2" intercept="-1.2" />
                </feComponentTransfer>
                <feGaussianBlur in="highlights" stdDeviation="10" result="blurred" />
                <!-- Bloom strength. -->
                <feComponentTransfer in="blurred" result="glow">
                    <feFuncR type="linear" slope="1.1" />
                    <feFuncG type="linear" slope="1.1" />
                    <feFuncB type="linear" slope="1.1" />
                </feComponentTransfer>
                <feBlend in="SourceGraphic" in2="glow" mode="screen" />
            </filter>

        </svg>

        <!-- Logo, centered below the header. The drawing leaves about 20% of the image empty below
             it, so a negative bottom margin of that much keeps the gap to the post the same as the
             gap below the post (mt-16). -->
        <div class="mt-16 flex justify-center">
            <!-- Logo as a stencil filled with the text color, so the page background shows
                 through and it follows the theme. A light frosted blur sits on top.
                 The pulsing glow comes from a copy of the logo on its own layer underneath:
                 a filter on the shared wrapper would stop the frosted blur from working. -->
            <div class="relative -mb-[3.2rem] size-64 md:-mb-[4.8rem] md:size-96">
                <div aria-hidden="true" class="logo-bloom absolute inset-0">
                    <div
                        class="size-full bg-foreground"
                        style={`-webkit-mask: url(${logoMask.src}) center / contain no-repeat; mask: url(${logoMask.src}) center / contain no-repeat;`}
                    ></div>
                </div>
                <div
                    role="img"
                    aria-label="Endangered Songs logo: a rider with a sword on a leaping horse"
                    class="relative size-full bg-foreground"
                    style={`-webkit-mask: url(${logoMask.src}) center / contain no-repeat; mask: url(${logoMask.src}) center / contain no-repeat;`}
                ></div>
                <div aria-hidden="true" class="absolute inset-0 backdrop-blur-[2px]"></div>
            </div>
        </div>

        <!-- Intro post about the project, below the logo. -->
        <div class="mx-auto mt-16 max-w-4xl">
            <Post
                video={denmark2Video}
                poster={denmark2Poster}
                label="Okh i ny plach, maty, ne ryday / Oh, do not weep, my mother, do not cry, performed by the Endangered Songs singers"
            >
                <p>
                    About twenty percent of Ukraine’s territory is currently under russian occupation. Towns and villages
                    have been devastated, and people have been forcibly uprooted. Some lands have been liberated since the
                    beginning of the full-scale invasion. Frontline communities continue to endure constant danger and loss,
                    while larger regions live under relentless daily strikes.
                </p>
                <p>
                    Left-Bank Ukraine — Central and Eastern Polissia, Slobozhanshchyna, the steppe parts of the Dnipro
                    region, and the South — have a unique place in Ukraine’s musical landscape. Each region, each district,
                    and at times even a single village has developed its own unique and recognizable singing tradition.
                    These traditions now face the risk of eradication – yet also provide a sense of continuity in a cultural
                    space marked by displacement, devastation, and efforts to erase local memory.
                </p>
                <p>
                    Within the Endangered Songs project, we present these songs to you — offering not only their sound, but
                    also the contexts, stories, and the meanings they take on in our time.
                </p>
            </Post>
        </div>

        <!-- Divider with a centered label. -->
        <div class="mt-16 flex items-center gap-4" role="separator">
            <div class="h-px flex-1 bg-border"></div>
            <span class="text-sm uppercase">Project Participants</span>
            <div class="h-px flex-1 bg-border"></div>
        </div>

        <!-- People in one row: photo, then name and Instagram underneath, all centered.
             Wraps onto more rows on narrow screens. -->
        <section class="mt-16 flex flex-wrap justify-center gap-x-6 gap-y-10 md:gap-x-8">
            {
                people.map((person) => (
                    <div class="flex w-36 flex-col items-center gap-3 text-center md:w-40">
                        <div class="size-32 shrink-0 overflow-hidden rounded-full md:size-40">
                            <Image
                                src={person.photo.src}
                                alt={person.photo.alt}
                                widths={[256, 320]}
                                sizes="(min-width: 768px) 160px, 128px"
                                class="bloom size-full object-cover"
                                style={person.photo.position && `object-position: ${person.photo.position}`}
                            />
                        </div>
                        <p class="text-lg leading-tight font-bold tracking-tight">{person.name}</p>
                        <!-- Pushed to the bottom, so the icons line up when a name wraps to two lines. -->
                        <a
                            href={person.instagram}
                            target="_blank"
                            rel="noopener"
                            class={buttonVariants({ variant: 'secondary', size: 'icon-lg', className: 'mt-auto' })}
                            aria-label={`${person.name} on Instagram`}
                            title="Instagram"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <rect x="2" y="2" width="20" height="20" rx="5" />
                                <circle cx="12" cy="12" r="4" />
                                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
                            </svg>
                        </a>
                    </div>
                ))
            }
        </section>
    </main>

</Layout>
