---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '@/components/ui/button';
import ThemeToggle from '../components/ThemeToggle.astro';
// Transparent copy of the logo (ink as alpha, frame removed), used as a CSS mask.
import logoMask from '../assets/endangered-songs-logo-mask.png';
// 480px square from kate.mp4 (full width, no sides cut, no audio) and its first frame.
import kateVideo from '../assets/kate-circle.mp4';
import katePoster from '../assets/kate-poster.jpg';
import yanaPhoto from '../assets/yana-kurlyak.png';
import darkaPhoto from '../assets/darka-symchych.png';
import melaniiaPhoto from '../assets/melaniia-oleshchuk.png';
import projectImage from '../assets/project.png';

const instagram = 'https://www.instagram.com/endangered_songs_project/';
const email = 'endangeredsongsproject@gmail.com';

// People shown below the header: each has a circular video or photo, a name and an Instagram link.
// A photo's optional `position` sets where the square crop sits (CSS object-position; default centered).
type Person = {
    name: string;
    instagram: string;
    video?: { src: string; poster: ImageMetadata };
    photo?: { src: ImageMetadata; alt: string; position?: string };
};
const people: Person[] = [
    {
        name: 'Kateryna Smirnova',
        instagram: 'https://www.instagram.com/katerynasmoss/',
        video: { src: kateVideo, poster: katePoster },
    },
    {
        name: 'Yana Kurlyak',
        instagram: 'https://www.instagram.com/yana_kurlyak/',
        photo: { src: yanaPhoto, alt: 'Portrait of Yana Kurlyak' },
    },
    {
        name: 'Darka Symchych',
        instagram: 'https://www.instagram.com/darusyaa_/',
        photo: { src: darkaPhoto, alt: 'Darka Symchych, silhouetted against a curtained window' },
    },
    {
        name: 'Melaniia Oleshchuk',
        instagram: 'https://www.instagram.com/melaniaoaoa/',
        // Portrait photo: aim the square crop higher so her face sits in the circle.
        photo: { src: melaniiaPhoto, alt: 'Soft-focus portrait of Melaniia Oleshchuk', position: '50% 25%' },
    },
];
---

<Layout title="Endangered Songs">
    <main class="w-full px-4 py-8 md:px-8 md:py-12">
        <header class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div class="flex flex-col items-start gap-4">
                <div class="flex items-center gap-3">
                    <!-- Logo as a stencil filled with the text color, so the page background shows
                         through and it follows the theme. A light frosted blur sits on top. -->
                    <div class="relative size-16 md:size-20">
                        <div
                            role="img"
                            aria-label="Endangered Songs logo: a rider with a sword on a leaping horse"
                            class="size-full bg-foreground"
                            style={`-webkit-mask: url(${logoMask.src}) center / contain no-repeat; mask: url(${logoMask.src}) center / contain no-repeat;`}
                        ></div>
                        <div aria-hidden="true" class="absolute inset-0 backdrop-blur-[2px]"></div>
                    </div>

                    <!-- Ukrainian flag behind the same 2px frosted blur as the logo.
                         The padding gives the blur room at the edges. -->
                    <div class="relative p-1">
                        <div
                            role="img"
                            aria-label="Flag of Ukraine"
                            class="flex h-8 w-12 flex-col overflow-hidden rounded-sm md:h-10 md:w-15"
                        >
                            <div class="flex-1 bg-[#0057b7]"></div>
                            <div class="flex-1 bg-[#ffd700]"></div>
                        </div>
                        <div aria-hidden="true" class="absolute inset-0 backdrop-blur-[2px]"></div>
                    </div>
                </div>
                <div class="flex flex-col gap-1">
                    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Endangered Songs</h1>
                    <p class="text-sm leading-relaxed">musical heritage under missiles<br />/ traditional singing from (de)occupied Ukraine</p>
                </div>
            </div>

            <!-- Theme toggle in the top-right corner, contact links aligned with the subtitle. -->
            <div class="flex flex-wrap items-center gap-2 sm:flex-col sm:items-end sm:justify-between sm:self-stretch">
                <div class="flex flex-wrap items-center gap-2">
                    <a
                        href={instagram}
                        target="_blank"
                        rel="noopener"
                        class={buttonVariants({ variant: 'secondary', size: 'icon-lg' })}
                        aria-label="Instagram"
                        title="Instagram"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <rect x="2" y="2" width="20" height="20" rx="5" />
                            <circle cx="12" cy="12" r="4" />
                            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
                        </svg>
                    </a>
                    <a href={`mailto:${email}`} class={buttonVariants({ variant: 'secondary', size: 'lg' })}>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <rect x="2" y="4" width="20" height="16" rx="2" />
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                        </svg>
                        {email}
                    </a>
                </div>
                <div class="sm:order-first">
                    <ThemeToggle />
                </div>
            </div>
        </header>

        <!-- Bloom: keep only the brightest parts of the picture, blur them, and screen them back
             over the original so highlights glow into their surroundings (used by .bloom). -->
        <svg class="absolute size-0" aria-hidden="true" focusable="false">
            <filter id="bloom" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
                <!-- Highlights only: luminance below ~55% maps to black. -->
                <feComponentTransfer in="SourceGraphic" result="highlights">
                    <feFuncR type="linear" slope="2.2" intercept="-1.2" />
                    <feFuncG type="linear" slope="2.2" intercept="-1.2" />
                    <feFuncB type="linear" slope="2.2" intercept="-1.2" />
                </feComponentTransfer>
                <feGaussianBlur in="highlights" stdDeviation="10" result="blurred" />
                <!-- Bloom strength. -->
                <feComponentTransfer in="blurred" result="glow">
                    <feFuncR type="linear" slope="1.1" />
                    <feFuncG type="linear" slope="1.1" />
                    <feFuncB type="linear" slope="1.1" />
                </feComponentTransfer>
                <feBlend in="SourceGraphic" in2="glow" mode="screen" />
            </filter>

            <!-- Softer variant for the project image (.bloom-soft): smaller blur, weaker glow. -->
            <filter id="bloom-soft" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
                <feComponentTransfer in="SourceGraphic" result="highlights">
                    <feFuncR type="linear" slope="2.2" intercept="-1.2" />
                    <feFuncG type="linear" slope="2.2" intercept="-1.2" />
                    <feFuncB type="linear" slope="2.2" intercept="-1.2" />
                </feComponentTransfer>
                <feGaussianBlur in="highlights" stdDeviation="6" result="blurred" />
                <feComponentTransfer in="blurred" result="glow">
                    <feFuncR type="linear" slope="0.6" />
                    <feFuncG type="linear" slope="0.6" />
                    <feFuncB type="linear" slope="0.6" />
                </feComponentTransfer>
                <feBlend in="SourceGraphic" in2="glow" mode="screen" />
            </filter>
        </svg>

        <!-- Divider with a centered label. -->
        <div class="mt-16 flex items-center gap-4" role="separator">
            <div class="h-px flex-1 bg-border"></div>
            <span class="text-sm uppercase">Project Participants</span>
            <div class="h-px flex-1 bg-border"></div>
        </div>

        <section class="mt-16 grid gap-8 sm:grid-cols-2">
            {
                people.map((person) => (
                    <div class="flex items-center gap-4">
                        <div class="size-36 shrink-0 overflow-hidden rounded-full md:size-48">
                            {person.video ? (
                                <video
                                    class="bloom size-full object-cover"
                                    src={person.video.src}
                                    poster={person.video.poster.src}
                                    autoplay
                                    muted
                                    loop
                                    playsinline
                                    preload="auto"
                                    aria-hidden="true"
                                    data-respect-reduced-motion
                                />
                            ) : (
                                person.photo && (
                                    <Image
                                        src={person.photo.src}
                                        alt={person.photo.alt}
                                        widths={[288, 384]}
                                        sizes="(min-width: 768px) 192px, 144px"
                                        class="bloom size-full object-cover"
                                        style={person.photo.position && `object-position: ${person.photo.position}`}
                                    />
                                )
                            )}
                        </div>
                        <div class="flex min-w-0 flex-wrap items-center gap-3">
                            <p class="text-2xl font-bold tracking-tight">{person.name}</p>
                            <a
                                href={person.instagram}
                                target="_blank"
                                rel="noopener"
                                class={buttonVariants({ variant: 'secondary', size: 'icon-lg' })}
                                aria-label={`${person.name} on Instagram`}
                                title="Instagram"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <rect x="2" y="2" width="20" height="20" rx="5" />
                                    <circle cx="12" cy="12" r="4" />
                                    <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
                                </svg>
                            </a>
                        </div>
                    </div>
                ))
            }
        </section>

        <!-- Divider with a centered label. -->
        <div class="mt-16 flex items-center gap-4" role="separator">
            <div class="h-px flex-1 bg-border"></div>
            <span class="text-sm uppercase">more</span>
            <div class="h-px flex-1 bg-border"></div>
        </div>

        <article class="mx-auto mt-16 max-w-2xl overflow-hidden rounded-xl bg-card text-card-foreground ring-1 ring-foreground/10">
            <Image
                src={projectImage}
                alt="Endangered Songs Project: woodcut of a rider with a sword on a leaping horse"
                widths={[400, 672, 874]}
                sizes="(min-width: 704px) 672px, calc(100vw - 32px)"
                class="bloom-soft block h-auto w-full"
            />
            <div class="space-y-4 p-6 text-sm leading-relaxed sm:p-8">
                <p>
                    About twenty percent of Ukraine’s territory is currently under russian occupation. Towns and villages
                    have been devastated, and people have been forcibly uprooted. Some lands have been liberated since the
                    beginning of the full-scale invasion. Frontline communities continue to endure constant danger and
                    loss, while larger regions live under relentless daily strikes.
                </p>
                <p>
                    Left-Bank Ukraine — Central and Eastern Polissia, Slobozhanshchyna, the steppe parts of the Dnipro
                    region, and the South — have a unique place in Ukraine’s musical landscape.
                </p>
                <p>
                    Each region, each district, and at times even a single village has developed its own unique and
                    recognizable singing tradition. These traditions now face the risk of eradication – yet also provide a
                    sense of continuity in a cultural space marked by displacement, devastation, and efforts to erase local
                    memory.
                </p>
                <p>
                    Within the Endangered Songs project, we present these songs to you — offering not only their sound,
                    but also the contexts, stories, and the meanings they take on in our time.
                </p>
            </div>
        </article>
    </main>

    <script>
        // Autoplaying video stays on its first frame for visitors who prefer reduced motion.
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-respect-reduced-motion]')) {
                video.pause();
                video.removeAttribute('autoplay');
            }
        }
    </script>
</Layout>
