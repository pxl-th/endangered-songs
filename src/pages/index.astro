---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '@/components/ui/button';
import Post from '../components/Post.astro';
import River from '../components/River.astro';
// Transparent copy of the logo (ink as alpha, frame removed), used as a CSS mask.
import logoMask from '../assets/endangered-songs-logo-mask.png';
import katePhoto from '../assets/kate.jpg';
import yanaPhoto from '../assets/yana-kurlyak.png';
import darkaPhoto from '../assets/darka.jpg';
import melaniiaPhoto from '../assets/melaniia-oleshchuk.png';
import martaPhoto from '../assets/marta.jpg';
// Posts: vertical 720×1280 videos, each with its title frame as the poster.
import denmark1Video from '../assets/denmark-1.mp4';
import denmark1Poster from '../assets/denmark-1-poster.jpg';
import denmark2Video from '../assets/denmark-2.mp4';
import denmark2Poster from '../assets/denmark-2-poster.jpg';
import denmark3Video from '../assets/denmark-3.mp4';
import denmark3Poster from '../assets/denmark-3-poster.jpg';

const instagram = 'https://www.instagram.com/endangered_songs_project/';
const email = 'endangeredsongsproject@gmail.com';

// People shown below the header: each has a circular photo, a name and an Instagram link.
// A photo's optional `position` sets where the square crop sits (CSS object-position; default centered).
type Person = {
    name: string;
    instagram: string;
    photo: { src: ImageMetadata; alt: string; position?: string };
};
const people: Person[] = [
    {
        name: 'Kateryna Smirnova',
        instagram: 'https://www.instagram.com/katerynasmoss/',
        // Landscape photo: shift the square crop left so she sits in the circle.
        photo: { src: katePhoto, alt: 'Kateryna Smirnova in an embroidered blouse, hands raised to her cheek, among trees', position: '35% 50%' },
    },
    {
        name: 'Yana Kurlyak',
        instagram: 'https://www.instagram.com/yana_kurlyak/',
        photo: { src: yanaPhoto, alt: 'Portrait of Yana Kurlyak' },
    },
    {
        name: 'Darka Symchych',
        instagram: 'https://www.instagram.com/darusyaa_/',
        photo: { src: darkaPhoto, alt: 'Black-and-white portrait of Darka Symchych looking up, in a white blouse' },
    },
    {
        name: 'Melaniia Oleshchuk',
        instagram: 'https://www.instagram.com/melaniaoaoa/',
        // Portrait photo: aim the square crop higher so her face sits in the circle.
        photo: { src: melaniiaPhoto, alt: 'Soft-focus portrait of Melaniia Oleshchuk', position: '50% 25%' },
    },
    {
        name: 'Marta Habalevych',
        instagram: 'https://www.instagram.com/marta.hab/',
        photo: { src: martaPhoto, alt: 'Portrait of Marta Habalevych in a black lace-collared blouse' },
    },
];
---

<Layout title="Endangered Songs">
    <main class="w-full px-4 py-8 md:px-8 md:py-12">
        <header class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div class="flex flex-col items-start gap-4">
                <div class="flex items-center gap-3">
                    <!-- Logo as a stencil filled with the text color, so the page background shows
                         through and it follows the theme. A light frosted blur sits on top. -->
                    <div class="relative size-16 md:size-20">
                        <div
                            role="img"
                            aria-label="Endangered Songs logo: a rider with a sword on a leaping horse"
                            class="size-full bg-foreground"
                            style={`-webkit-mask: url(${logoMask.src}) center / contain no-repeat; mask: url(${logoMask.src}) center / contain no-repeat;`}
                        ></div>
                        <div aria-hidden="true" class="absolute inset-0 backdrop-blur-[2px]"></div>
                    </div>

                    <!-- Ukrainian flag behind the same 2px frosted blur as the logo.
                         The padding gives the blur room at the edges. -->
                    <div class="relative p-1">
                        <div
                            role="img"
                            aria-label="Flag of Ukraine"
                            class="flex h-8 w-12 flex-col overflow-hidden rounded-sm md:h-10 md:w-15"
                        >
                            <div class="flex-1 bg-[#0057b7]"></div>
                            <div class="flex-1 bg-[#ffd700]"></div>
                        </div>
                        <div aria-hidden="true" class="absolute inset-0 backdrop-blur-[2px]"></div>
                    </div>
                </div>
                <div class="flex flex-col gap-1">
                    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Endangered Songs</h1>
                    <p class="text-sm leading-relaxed">musical heritage under missiles<br />/ traditional singing from (de)occupied Ukraine</p>
                </div>
            </div>

            <!-- Contact links, aligned with the subtitle. -->
            <div class="flex flex-wrap items-center gap-2">
                <a
                    href={instagram}
                    target="_blank"
                    rel="noopener"
                    class={buttonVariants({ variant: 'secondary', size: 'icon-lg' })}
                    aria-label="Instagram"
                    title="Instagram"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <rect x="2" y="2" width="20" height="20" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
                    </svg>
                </a>
                <a href={`mailto:${email}`} class={buttonVariants({ variant: 'secondary', size: 'lg' })}>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                    {email}
                </a>
            </div>
        </header>

        <!-- Bloom: keep only the brightest parts of the picture, blur them, and screen them back
             over the original so highlights glow into their surroundings (used by .bloom). -->
        <svg class="absolute size-0" aria-hidden="true" focusable="false">
            <filter id="bloom" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
                <!-- Highlights only: luminance below ~55% maps to black. -->
                <feComponentTransfer in="SourceGraphic" result="highlights">
                    <feFuncR type="linear" slope="2.2" intercept="-1.2" />
                    <feFuncG type="linear" slope="2.2" intercept="-1.2" />
                    <feFuncB type="linear" slope="2.2" intercept="-1.2" />
                </feComponentTransfer>
                <feGaussianBlur in="highlights" stdDeviation="10" result="blurred" />
                <!-- Bloom strength. -->
                <feComponentTransfer in="blurred" result="glow">
                    <feFuncR type="linear" slope="1.1" />
                    <feFuncG type="linear" slope="1.1" />
                    <feFuncB type="linear" slope="1.1" />
                </feComponentTransfer>
                <feBlend in="SourceGraphic" in2="glow" mode="screen" />
            </filter>

        </svg>

        <!-- Divider with a centered label. -->
        <div class="mt-16 flex items-center gap-4" role="separator">
            <div class="h-px flex-1 bg-border"></div>
            <span class="text-sm uppercase">Recordings</span>
            <div class="h-px flex-1 bg-border"></div>
        </div>

        <!-- Posts, newest first, joined by a meandering line down the middle, behind the posts.
             Each post's date and dot sit in the row above it, which also spaces the posts. -->
        <div class="mx-auto mt-16 max-w-4xl">
            <River>
                <div class="flex flex-col gap-10">
                    <Post
                        video={denmark1Video}
                        poster={denmark1Poster}
                        label="Chy doma doma molodyi Ivanko? / Is young Ivan at home?, performed by the Endangered Songs singers"
                        source="field recording by Oleksandr Pravdiuk, 1972."
                        location="Vepryk village, Hadiach district, Poltava region"
                        date="2025-12-24"
                    >
                        <p class="font-bold">IS YOUNG IVAN AT HOME</p>
                        <p>
                            Christmas Eve is a time to think of those closest to us, even when they are far away. In Ukrainian
                            tradition, carols are often addressed to someone dear.
                        </p>
                        <p>
                            This song is for a son serving in the army — absent from the table, yet present in every thought. A
                            situation that remains painfully true for many families today.
                        </p>
                        <p>A rear region, strongly affected by missile attacks.</p>
                        <p>We perform the Poltava variant; a Sumy version of the carol is also documented.</p>
                    </Post>

                    <Post
                        video={denmark3Video}
                        poster={denmark3Poster}
                        label="Zatsviv teren shche y loza / Blackthorn blooms, and so does the willow, performed by the Endangered Songs singers"
                        location="Vodyane village, Kamyansk-Dnipro district, Zaporizhzhia region"
                        occupied="Occupied since 2022."
                        date="2025-12-05"
                    >
                        <p class="font-bold">
                            ZATSVIV TEREN SHCHE Y LOZA<br />/ BLACKTHORN BLOOMS, AND SO DOES THE WILLOW
                        </p>
                        <p>
                            A lyrical song from the Zaporizhzhia region about a young woman whose heart has grown forlorn.
                            Holding a nightingale in her hands, she asks it to sing for her in a foreign land, where she is left
                            without her parents or her beloved Vanyusha.
                        </p>
                        <Fragment slot="source">
                            Field recording by Both Miklos, Illya Fetysov, Susanna Karpenko.
                            <a
                                href="https://polyphonyproject.com/"
                                target="_blank"
                                rel="noopener"
                                class="underline underline-offset-2 hover:text-foreground">polyphonyproject.com</a
                            >
                        </Fragment>
                    </Post>

                    <Post
                        video={denmark2Video}
                        poster={denmark2Poster}
                        label="Okh i ny plach, maty, ne ryday / Oh, do not weep, my mother, do not cry, performed by the Endangered Songs singers"
                        source="Concert recording by the Serpanok folk ensemble, based on an original field recording preserved in the Dubravin family archive."
                        location="Terny village, Romny district, Sumy region"
                        date="2025-12-01"
                    >
                        <p class="font-bold">OH, DO NOT WEEP, MY MOTHER, DO NOT CRY</p>
                        <p>A recruit song from the Sumy region about a son reassuring his mother as he heads off to war.</p>
                        <p>
                            The area suffered during the russian invasion in 2022. Just 36 km from the russian border, it remains
                            at high risk and under constant shelling.
                        </p>
                    </Post>
                </div>
            </River>
        </div>

        <!-- Divider with a centered label. -->
        <div class="mt-16 flex items-center gap-4" role="separator">
            <div class="h-px flex-1 bg-border"></div>
            <span class="text-sm uppercase">Project Participants</span>
            <div class="h-px flex-1 bg-border"></div>
        </div>

        <!-- People in one row: photo, then name and Instagram underneath, all centered.
             Wraps onto more rows on narrow screens. -->
        <section class="mt-16 flex flex-wrap justify-center gap-x-6 gap-y-10 md:gap-x-8">
            {
                people.map((person) => (
                    <div class="flex w-36 flex-col items-center gap-3 text-center md:w-40">
                        <div class="size-32 shrink-0 overflow-hidden rounded-full md:size-40">
                            <Image
                                src={person.photo.src}
                                alt={person.photo.alt}
                                widths={[256, 320]}
                                sizes="(min-width: 768px) 160px, 128px"
                                class="bloom size-full object-cover"
                                style={person.photo.position && `object-position: ${person.photo.position}`}
                            />
                        </div>
                        <p class="text-lg leading-tight font-bold tracking-tight">{person.name}</p>
                        <!-- Pushed to the bottom, so the icons line up when a name wraps to two lines. -->
                        <a
                            href={person.instagram}
                            target="_blank"
                            rel="noopener"
                            class={buttonVariants({ variant: 'secondary', size: 'icon-lg', className: 'mt-auto' })}
                            aria-label={`${person.name} on Instagram`}
                            title="Instagram"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <rect x="2" y="2" width="20" height="20" rx="5" />
                                <circle cx="12" cy="12" r="4" />
                                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
                            </svg>
                        </a>
                    </div>
                ))
            }
        </section>
    </main>

</Layout>
